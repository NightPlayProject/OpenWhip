{
  "name": "@nightplayproject/openwhip",
  "version": "1.4.0",
  "description": "Global desktop whip with timed Ctrl+C, message and automatic Enter in the active app",
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "openwhip": "bin/openwhip.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightPlayProject/OpenWhip.git"
  },
  "bugs": {
    "url": "https://github.com/NightPlayProject/OpenWhip/issues"
  },
  "homepage": "https://github.com/NightPlayProject/OpenWhip#readme",
  "files": [
    "main.js",
    "lib",
    "preload.js",
    "overlay.html",
    "overlay.js",
    "message.html",
    "message.js",
    "message-preload.js",
    "sounds",
    "icon",
    "bin/openwhip.js",
    "assets/divider.png",
    "VALIDATION.md",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "test": "node --test test/*.test.js",
    "test:windows": "node scripts/smoke-windows.js",
    "test:ui": "node scripts/run-ui-smoke.js",
    "test:motion": "node scripts/run-motion-visual.js"
  },
  "dependencies": {
    "electron": "44.7.0",
    "koffi": "3.3.2"
  }
}
